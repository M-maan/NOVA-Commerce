{
  "name": "nova-commerce",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @nova/api --filter @nova/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @nova/api prisma:generate",
    "db:migrate": "pnpm --filter @nova/api prisma:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  }
}
