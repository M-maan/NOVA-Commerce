generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVATION
  RESERVATION_RELEASE
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED
}

enum CheckoutStatus {
  ACTIVE
  PAYMENT_PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum ShippingMethodStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id                 String                  @id @default(cuid())
  uuid               String                  @unique @default(uuid())
  firstName          String?                 @map("first_name")
  lastName           String?                 @map("last_name")
  fullName           String?                 @map("full_name")
  email              String                  @unique
  phone              String?                 @unique
  passwordHash       String                  @map("password_hash")
  profileImage       String?                 @map("profile_image")
  role               Role                    @default(CUSTOMER)
  emailVerified      Boolean                 @default(false) @map("email_verified")
  phoneVerified      Boolean                 @default(false) @map("phone_verified")
  status             UserStatus              @default(PENDING)
  lastLogin          DateTime?               @map("last_login")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  addresses          UserAddress[]
  refreshTokens      RefreshToken[]
  recentlyViewed     RecentlyViewedProduct[]
  carts              Cart[]
  wishlists          Wishlist[]
  inventoryMovements InventoryMovement[]
  checkoutSessions   CheckoutSession[]
  payments           Payment[]

  @@index([role, status])
  @@map("users")
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  title        String
  fullName     String   @map("full_name")
  phone        String
  country      String
  province     String
  city         String
  postalCode   String?  @map("postal_code")
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  device    String?
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Category {
  id              String            @id @default(cuid())
  uuid            String            @unique @default(uuid())
  name            String
  slug            String            @unique
  description     String?
  image           String?
  parentId        String?           @map("parent_id")
  status          CatalogStatus     @default(ACTIVE)
  sortOrder       Int               @default(0) @map("sort_order")
  metaTitle       String?           @map("meta_title")
  metaDescription String?           @map("meta_description")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]

  @@index([parentId])
  @@index([status, sortOrder])
  @@map("categories")
}

model Brand {
  id          String        @id @default(cuid())
  uuid        String        @unique @default(uuid())
  name        String
  slug        String        @unique
  description String?
  logo        String?
  websiteUrl  String?       @map("website_url")
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  products    Product[]

  @@index([status])
  @@map("brands")
}

model Product {
  id               String                  @id @default(cuid())
  uuid             String                  @unique @default(uuid())
  name             String
  slug             String                  @unique
  shortDescription String?                 @map("short_description")
  description      String?
  brandId          String?                 @map("brand_id")
  productType      ProductType             @default(SIMPLE) @map("product_type")
  status           CatalogStatus           @default(DRAFT)
  basePrice        Decimal                 @map("base_price") @db.Decimal(12, 2)
  compareAtPrice   Decimal?                @map("compare_at_price") @db.Decimal(12, 2)
  costPrice        Decimal?                @map("cost_price") @db.Decimal(12, 2)
  currency         String                  @default("USD")
  featured         Boolean                 @default(false)
  publishedAt      DateTime?               @map("published_at")
  metaTitle        String?                 @map("meta_title")
  metaDescription  String?                 @map("meta_description")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  brand            Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories       ProductCategory[]
  variants         ProductVariant[]
  options          ProductOption[]
  images           ProductImage[]
  recentlyViewed   RecentlyViewedProduct[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]

  @@index([brandId])
  @@index([status, featured, publishedAt])
  @@index([createdAt])
  @@map("products")
}

model Cart {
  id               String             @id @default(cuid())
  uuid             String             @unique @default(uuid())
  userId           String?            @map("user_id")
  guestSessionId   String?            @map("guest_session_id")
  status           CartStatus         @default(ACTIVE)
  currency         String             @default("USD")
  couponId         String?            @map("coupon_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  expiresAt        DateTime?          @map("expires_at")
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            CartItem[]
  reservations     StockReservation[]
  coupon           Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  checkoutSessions CheckoutSession[]

  @@unique([userId, status])
  @@unique([guestSessionId, status])
  @@map("carts")
}

model CartItem {
  id                String          @id @default(cuid())
  cartId            String          @map("cart_id")
  productId         String          @map("product_id")
  variantId         String?         @map("variant_id")
  quantity          Int
  unitPriceSnapshot Decimal         @map("unit_price_snapshot") @db.Decimal(12, 2)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String          @id @default(cuid())
  wishlistId String          @map("wishlist_id")
  productId  String          @map("product_id")
  variantId  String?         @map("variant_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@map("wishlist_items")
}

model Promotion {
  id                 String        @id @default(cuid())
  name               String
  description        String?
  type               PromotionType
  value              Decimal       @db.Decimal(12, 2)
  minimumOrderAmount Decimal?      @map("minimum_order_amount") @db.Decimal(12, 2)
  maximumDiscount    Decimal?      @map("maximum_discount") @db.Decimal(12, 2)
  startsAt           DateTime      @map("starts_at")
  endsAt             DateTime?     @map("ends_at")
  usageLimit         Int?          @map("usage_limit")
  usagePerUser       Int?          @map("usage_per_user")
  status             CatalogStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  coupons            Coupon[]

  @@map("promotions")
}

model Coupon {
  id          String        @id @default(cuid())
  code        String        @unique
  promotionId String        @map("promotion_id")
  usageLimit  Int?          @map("usage_limit")
  usageCount  Int           @default(0) @map("usage_count")
  startsAt    DateTime      @map("starts_at")
  expiresAt   DateTime?     @map("expires_at")
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  promotion   Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  carts       Cart[]

  @@map("coupons")
}

model RecentlyViewedProduct {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed_products")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id                 String                      @id @default(cuid())
  uuid               String                      @unique @default(uuid())
  productId          String                      @map("product_id")
  name               String
  sku                String?                     @unique
  barcode            String?                     @unique
  price              Decimal                     @db.Decimal(12, 2)
  compareAtPrice     Decimal?                    @map("compare_at_price") @db.Decimal(12, 2)
  costPrice          Decimal?                    @map("cost_price") @db.Decimal(12, 2)
  weight             Decimal?                    @db.Decimal(10, 3)
  status             CatalogStatus               @default(ACTIVE)
  isDefault          Boolean                     @default(false) @map("is_default")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  product            Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues       ProductVariantOptionValue[]
  images             ProductImage[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  reservations       StockReservation[]

  @@index([productId, status])
  @@map("product_variants")
}

model Warehouse {
  id           String              @id @default(cuid())
  uuid         String              @unique @default(uuid())
  name         String
  code         String              @unique
  address      String?
  city         String?
  province     String?
  country      String?
  status       WarehouseStatus     @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  levels       InventoryLevel[]
  movements    InventoryMovement[]
  reservations StockReservation[]

  @@map("warehouses")
}

model InventoryLevel {
  id                String         @id @default(cuid())
  warehouseId       String         @map("warehouse_id")
  productVariantId  String         @map("product_variant_id")
  quantityAvailable Int            @default(0) @map("quantity_available")
  quantityReserved  Int            @default(0) @map("quantity_reserved")
  reorderLevel      Int            @default(0) @map("reorder_level")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id               String                @id @default(cuid())
  warehouseId      String                @map("warehouse_id")
  productVariantId String                @map("product_variant_id")
  type             InventoryMovementType
  quantity         Int
  referenceType    String?               @map("reference_type")
  referenceId      String?               @map("reference_id")
  reason           String?
  createdBy        String?               @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant          ProductVariant        @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  actor            User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([warehouseId, productVariantId, createdAt])
  @@map("inventory_movements")
}

model StockReservation {
  id               String            @id @default(cuid())
  cartId           String            @map("cart_id")
  warehouseId      String            @map("warehouse_id")
  productVariantId String            @map("product_variant_id")
  quantity         Int
  status           ReservationStatus @default(ACTIVE)
  expiresAt        DateTime          @map("expires_at")
  releasedAt       DateTime?         @map("released_at")
  convertedAt      DateTime?         @map("converted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  cart             Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant          ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([cartId, status])
  @@map("stock_reservations")
}

model ShippingMethod {
  id            String               @id @default(cuid())
  uuid          String               @unique @default(uuid())
  name          String
  code          String               @unique
  description   String?
  price         Decimal              @db.Decimal(12, 2)
  estimatedDays Int                  @map("estimated_days")
  status        ShippingMethodStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  checkouts     CheckoutSession[]

  @@index([status])
  @@map("shipping_methods")
}

model CheckoutSession {
  id               String          @id @default(cuid())
  uuid             String          @unique @default(uuid())
  userId           String          @map("user_id")
  cartId           String          @map("cart_id")
  status           CheckoutStatus  @default(ACTIVE)
  currency         String          @default("USD")
  subtotal         Decimal         @db.Decimal(12, 2)
  discountTotal    Decimal         @map("discount_total") @db.Decimal(12, 2)
  shippingTotal    Decimal         @map("shipping_total") @db.Decimal(12, 2)
  taxTotal         Decimal         @map("tax_total") @db.Decimal(12, 2)
  grandTotal       Decimal         @map("grand_total") @db.Decimal(12, 2)
  shippingAddress  Json            @map("shipping_address")
  billingAddress   Json?           @map("billing_address")
  shippingMethodId String?         @map("shipping_method_id")
  expiresAt        DateTime        @map("expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  payments         Payment[]

  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("checkout_sessions")
}

model Payment {
  id                String          @id @default(cuid())
  uuid              String          @unique @default(uuid())
  userId            String          @map("user_id")
  checkoutSessionId String          @map("checkout_session_id")
  orderId           String?         @map("order_id")
  provider          String          @default("stripe")
  providerPaymentId String?         @unique @map("provider_payment_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  paymentMethod     String?         @map("payment_method")
  failureReason     String?         @map("failure_reason")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([userId, status])
  @@index([checkoutSessionId])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(cuid())
  paymentId       String    @map("payment_id")
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  status          String
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model ProductOption {
  id        String               @id @default(cuid())
  uuid      String               @unique @default(uuid())
  productId String               @map("product_id")
  name      String
  sortOrder Int                  @default(0) @map("sort_order")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_options")
}

model ProductOptionValue {
  id        String                      @id @default(cuid())
  uuid      String                      @unique @default(uuid())
  optionId  String                      @map("option_id")
  value     String
  sortOrder Int                         @default(0) @map("sort_order")
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  option    ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, sortOrder])
  @@map("product_option_values")
}

model ProductVariantOptionValue {
  variantId     String             @map("variant_id")
  optionValueId String             @map("option_value_id")
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("product_variant_option_values")
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String          @map("product_id")
  variantId String?         @map("variant_id")
  imageUrl  String          @map("image_url")
  publicId  String?         @map("public_id")
  altText   String?         @map("alt_text")
  sortOrder Int             @default(0) @map("sort_order")
  isPrimary Boolean         @default(false) @map("is_primary")
  createdAt DateTime        @default(now()) @map("created_at")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}
